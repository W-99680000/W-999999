{
  "schema": 1,
  "updated": "2026-08-13",
  "means": {
    "asr": "语音识别（听写）：把音频变成原文",
    "mt": "机器翻译：把原文变成译文",
    "router": "译器选路：源语言 → 用哪个译器",
    "modes": "两个翻译模块。只存与 defaults 的差异（null = 跟随默认）",
    "vram_mb": "显存预算（MB）。本地模型取实测值；远端/离线为 0",
    "available": "此刻是否真的可用（按本机实况探测，不是愿望）"
  },
  "defaults": {
    "asr": "local:faster-whisper-medium",
    "mt": "remote:qwen-mt-flash",
    "router": {
      "allow_offline": false
    }
  },
  "modes": {
    "loopback": {
      "label": "实时回环系统",
      "goal": "低延迟：音频播出来才存在，等不起",
      "asr": null,
      "asr_stream": null,
      "mt": null,
      "params": {
        "max_batch": 2.0,
        "max_wait": 1.2,
        "mt_batch": 2,
        "mt_batch_wait": 0.35,
        "mt_cap": 2.0,
        "min_seg": 0.5,
        "max_seg": 4.0,
        "vad_silence": 0.45,
        "remote_asr": true
      }
    },
    "cache": {
      "label": "视频缓存",
      "goal": "高准确：整片先识别后翻译，首句零延迟",
      "asr": "local:faster-whisper-large-v3",
      "asr_stream": null,
      "mt": null,
      "params": {
        "mt_batch": 8,
        "force": false
      }
    }
  },
