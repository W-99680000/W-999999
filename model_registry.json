        "max_batch": 2.0,
        "max_wait": 1.2,
        "mt_batch": 2,
        "mt_batch_wait": 0.35,
        "mt_cap": 2.0,
        "min_seg": 0.5,
        "max_seg": 4.0,
        "vad_silence": 0.45,
        "remote_asr": true
      }
    },
